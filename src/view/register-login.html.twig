{% extends 'index.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/register-login.css">
<script src="/assets/js/register-login.js"></script>
{% endblock %}

{% block title %}Regisztráció/Bejelentkezés{% endblock %}

{% block body %}
<div class="container" id="container">
	<div class="form-container sign-up-container">
		<form action="/register" method="post">
			<h1>Fiók létrehozása</h1>
			<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
			<input type="text" name="username" placeholder="Felhasználónév" value="{{ old.username ?? '' }}" required />

			{% if errors.username %}
			<span style="color: red; font-size: 12px;">{{ errors.username|first }}</span>
			{% endif %}

			<input type="email" name="email" placeholder="Email" value="{{ old.email ?? '' }}" required />

			{% if errors.email %}
			<span style="color: red; font-size: 12px;">{{ errors.email|first }}</span>
			{% endif %}

			<input type="text" name="last_name" placeholder="Vezetéknév" value="{{ old.last_name ?? '' }}" required />

			{% if errors.last_name %}
			<span style="color: red; font-size: 12px;">{{ errors.last_name|first }}</span>
			{% endif %}

			<input type="text" name="first_name" placeholder="Keresztnév" value="{{ old.first_name ?? '' }}" required />

			{% if errors.first_name %}
			<span style="color: red; font-size: 12px;">{{ errors.first_name|first }}</span>
			{% endif %}

			<input type="password" name="password" placeholder="Jelszó" required />

			{% if errors.password %}
			<span style="color: red; font-size: 12px;">{{ errors.password|first }}</span>
			{% endif %}

			<input type="password" name="confirm_password" placeholder="Jelszó megismétlése" required />

			{% if errors.confirm_password %}
			<span style="color: red; font-size: 12px;">{{ errors.confirm_password|first }}</span>
			{% endif %}

			<button type="submit">Regisztráció</button>
		</form>
	</div>
	<div class="form-container sign-in-container">
		<form action="/login" method="post">
			<h1>Bejelentkezés</h1>
			<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
			<input type="text" name="email_username" placeholder="Email / Felhasználónév"
				value="{{ old.email_username ?? '' }}" required />

			{% if errors.email_username %}
			<span style="color: red; font-size: 12px;">{{ errors.email_username|first }}</span>
			{% endif %}

			<input type="password" name="password" placeholder="Jelszó" required />

			{% if errors.password %}
			<span style="color: red; font-size: 12px;">{{ errors.password|first }}</span>
			{% endif %}

			<button type="submit">Bejelentkezés</button>
		</form>
	</div>
	<div class="overlay-container">
		<div class="overlay">
			<div class="overlay-panel overlay-left">
				<h1>Üdv újra itt!</h1>
				<p>Kérlek add meg a kért adatokat a bejelentkezéshez</p>
				<button class="ghost" id="signIn">Bejelentkezés</button>
			</div>
			<div class="overlay-panel overlay-right">
				<h1>Üdvözöllek!</h1>
				<p>Add meg személyes adataidat a regisztrációhoz</p>
				<button class="ghost" id="signUp">Regisztráció</button>
			</div>
		</div>
	</div>
</div>
{% endblock %}